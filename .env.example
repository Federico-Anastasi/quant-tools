# Production Environment Variables
# IMPORTANT: Copy this file to .env and set secure values
# .env is gitignored and should NEVER be committed

# Database password (REQUIRED - generate a strong password)
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# CORS origins (production domain - psiquant.xyz)
# Add both HTTP and HTTPS variants (HTTP will redirect to HTTPS after SSL setup)
CORS_ORIGINS=https://psiquant.xyz,https://www.psiquant.xyz,http://psiquant.xyz,http://www.psiquant.xyz

# Development Environment Variables (for local testing only)
# Frontend .env (create frontend/.env.local for development)
# VITE_API_URL=http://localhost:8002

# Frontend .env.production (create frontend/.env.production for production builds)
# VITE_API_URL=https://psiquant.xyz/api
