# Production Environment Variables for PsiQuant
# IMPORTANT: Copy this file to .env and set secure values
# .env is gitignored and should NEVER be committed

# ============================================================================
# DATABASE
# ============================================================================
# Database password (REQUIRED - generate a strong password)
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ============================================================================
# BACKEND SECURITY
# ============================================================================
# Your production frontend domain (REQUIRED - with protocol, NO trailing slash)
# This is the ONLY domain that can make API requests in production
# Example: https://psiquant.xyz or https://www.psiquant.xyz
FRONTEND_URL=https://psiquant.xyz

# ============================================================================
# ENVIRONMENT MODE
# ============================================================================
# Automatically set in docker-compose files:
# - docker-compose.yml → ENV=development (enables /docs, localhost CORS)
# - docker-compose.prod.yml → ENV=production (disables /docs, strict CORS)

# ============================================================================
# SECURITY FEATURES ENABLED IN PRODUCTION
# ============================================================================
# When ENV=production:
# ✓ Swagger/OpenAPI documentation DISABLED (/docs, /redoc, /openapi.json)
# ✓ CORS restricted to FRONTEND_URL ONLY
# ✓ No localhost access allowed
# ✓ API endpoints hidden from root response

# ============================================================================
# DEVELOPMENT MODE (docker-compose.yml)
# ============================================================================
# When ENV=development:
# ✓ Swagger UI enabled at /docs
# ✓ ReDoc enabled at /redoc
# ✓ OpenAPI schema at /openapi.json
# ✓ CORS allows localhost:3000, localhost:8080, localhost:8082
# ✓ Hot-reload enabled (--reload flag)
