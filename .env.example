# Production Environment Variables
# IMPORTANT: Copy this file to .env and set secure values
# .env is gitignored and should NEVER be committed

# Database password (REQUIRED - generate a strong password)
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# CORS origins (set to your production domain/IP)
CORS_ORIGINS=http://your-server-ip-or-domain

# Development Environment Variables (for local testing only)
# Frontend .env (create .env in frontend/)
# VITE_API_URL=http://localhost:8002
